//
// Gossamer Multi-Window Example — demonstrates creating and managing multiple windows.
//
// This example creates two windows with different sizes, registers them in the
// window registry, creates a window group, and adds both windows to it.
//
// The webview handles are LINEAR: each must be consumed by Shell.run() or
// explicitly destroyed.

fn main(): I32 =
  region app {
    -- Create first window (main window)
    let! window1 = Shell.create("Multi-Window - Main", 1024, 768) in

    -- Create second window (sidebar/auxiliary)
    let! window2 = Shell.create("Multi-Window - Sidebar", 400, 768) in

    -- Load HTML into first window
    let! window1 = Shell.loadHTML(window1, """
      <html>
      <head>
        <style>
          body { 
            font-family: system-ui, sans-serif; 
            margin: 0; 
            padding: 20px; 
            background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
            color: #e0e0e0;
          }
          h1 { color: #ff6b6b; }
          p { opacity: 0.8; }
          .info { 
            background: rgba(255,255,255,0.1); 
            padding: 15px; 
            border-radius: 8px; 
            margin-top: 20px;
          }
        </style>
      </head>
      <body>
        <h1>Main Window</h1>
        <p>This is the primary window in a multi-window Gossamer application.</p>
        <div class="info">
          <p><strong>Window ID:</strong> 1</p>
          <p><strong>Size:</strong> 1024x768</p>
          <p>Close both windows to exit.</p>
        </div>
      </body>
      </html>
    """) in

    -- Load HTML into second window
    let! window2 = Shell.loadHTML(window2, """
      <html>
      <head>
        <style>
          body { 
            font-family: system-ui, sans-serif; 
            margin: 0; 
            padding: 20px; 
            background: linear-gradient(135deg, #0f3460 0%, #16213e 100%);
            color: #e0e0e0;
          }
          h1 { color: #e94560; }
          p { opacity: 0.8; }
          .info { 
            background: rgba(255,255,255,0.1); 
            padding: 15px; 
            border-radius: 8px; 
            margin-top: 20px;
          }
        </style>
      </head>
      <body>
        <h1>Sidebar Window</h1>
        <p>This is an auxiliary window demonstrating multi-window support.</p>
        <div class="info">
          <p><strong>Window ID:</strong> 2</p>
          <p><strong>Size:</strong> 400x768</p>
          <p>Part of the same window group.</p>
        </div>
      </body>
      </html>
    """) in

    -- Note: In the actual run.eph, we need to use the FFI API for registry and groups
    -- This main.eph shows the conceptual Ephapax-side logic
    -- The actual implementation uses __ffi calls in run.eph

    -- For demonstration purposes, we'll run one window at a time
    -- In a real multi-window app, each window would run in its own thread
    let! _ = Shell.run(window1) in
    let! _ = Shell.run(window2) in

    0
  }
